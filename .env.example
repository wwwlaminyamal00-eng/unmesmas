# ============================================================
# ERP Multiempresa - Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo .env a GitHub ni lo compartas.
# ============================================================

# Conexión a PostgreSQL / Supabase (Settings > Database > Connection string > URI, modo "Transaction pooler")
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:6543/postgres

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Desarrollo local
FLASK_DEBUG=false
PORT=5000

# En producción (HTTPS) poner true para que la cookie de sesión solo viaje cifrada
SESSION_COOKIE_SECURE=false
# Horas que dura la sesión
SESSION_HORAS=10

# Roles (separados por coma, en minúsculas, tal como están en la columna usuarios.rol)
ROLES_ADMIN=admin,administrador,superadmin,gerencia_total,gerencia
ROLES_APROBADORES=hellen,erika,admin,superadmin,administrador,gerencia_total,gerencia,supervisor
ROLES_FINANZAS=finanzas,contabilidad,tesoreria,gerencia
# Inventario: logística registra entradas, salidas y traslados; control hace los conteos (logística NO cuenta)
ROLES_ALMACEN=almacen,almacenero,logistica,logistico
ROLES_CONTROL_INVENTARIO=control,inventario,auditor,contabilidad,finanzas
# Días sin venta para marcar un producto como "Lento" e "Inmovilizado"
INV_DIAS_LENTO=30
INV_DIAS_INMOVILIZADO=90
# Días que dura una separación de stock por defecto, y aviso de vencimiento de lotes
INV_DIAS_SEPARACION=7
INV_DIAS_AVISO_VENCIMIENTO=30
INV_PRODUCTOS_CONTEO_SORPRESA=10

# Compras: quién prepara órdenes de compra (aprobar = ROLES_APROBADORES, pagar = ROLES_FINANZAS, recibir = ROLES_ALMACEN)
ROLES_COMPRAS=compras,comprador,logistica,logistico,asistente_compras
# Monto (S/ con IGV) hasta el cual una OC bajo pedido se aprueba sola. 0 = todas necesitan aprobación
COMPRAS_MONTO_SIN_APROBACION=0
# Alerta si el precio sube más de este % respecto a la última compra del mismo producto
COMPRAS_ALERTA_PRECIO_PCT=10
# Diferencia máxima (S/) para decir que la factura del proveedor cuadra con lo recibido
COMPRAS_TOLERANCIA_FACTURA=1.00
# Días para avisar: pagado y no llega la mercadería / recibido y no llega la factura
COMPRAS_DIAS_AVISO=3

# Si es false, un vendedor puede generar una cotización sin validación previa
COTIZACION_REQUIERE_VALIDACION=true

# Tasa de IGV
IGV_TASA=0.18

# Opcional: solo si se usa el login con Supabase Auth (verificar_usuario_supabase)
SUPABASE_URL=
SUPABASE_KEY=
